# ──────────────────────────────────────────────────────────────────────────────
# NxtSend Environment Variables
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# NEVER commit .env.local or any file containing real credentials.
# The app operates in Demo Mode when these variables are missing or placeholder.
# ──────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
# Public base URL of the application
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Set to https://nxtsend.com in production

# Node environment
NODE_ENV=development

# Force the in-app Demo Mode banner ON even when Supabase is configured
# (read by src/components/ui/DemoBanner.tsx). Banner override only —
# it does not switch the data mode. Leave unset for normal use.
NEXT_PUBLIC_DEMO_MODE=

# ── Supabase (Database & Auth) ─────────────────────────────────────────────────
# Get these from: https://app.supabase.com → Your Project → Settings → API
#
# Public (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ⚠️  SERVER ONLY — Never expose this in client-side code or the browser!
# Used for admin operations (bypasses RLS). Keep this secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Admin Bootstrap ────────────────────────────────────────────────────────────
# One-time secret used to promote the owner's account
# (mithusquare@gmail.com) to super_admin via /api/admin/bootstrap.
# After bootstrap, REMOVE this variable from your environment.
# Generate a strong value: openssl rand -base64 64
# ⚠️  Remove after first use to prevent unauthorized re-use.
ADMIN_BOOTSTRAP_SECRET=change-me-to-a-random-64-character-string-before-use

# ── Email Provider (Resend) ────────────────────────────────────────────────────
# Get from: https://resend.com/api-keys
# Leave empty/missing to use Demo Mode (no emails will be sent)
RESEND_API_KEY=re_your_resend_api_key

# From address for transactional emails (must be verified in Resend)
EMAIL_FROM=hello@nxtsend.com

# Signing secret for Resend delivery webhooks (Svix scheme).
# Get it from the Resend dashboard when you register the webhook endpoint
# https://<your-domain>/api/webhooks/resend — starts with whsec_.
# ⚠️  While this is unset, the webhook route REJECTS events (503) rather
# than accepting them unverified.
RESEND_WEBHOOK_SECRET=whsec_your_resend_webhook_secret

# Reply-To for all outbound email (campaign steps + inbox replies).
# Point this at an address on your RECEIVING domain (see SETUP.md §6)
# so replies are delivered back to the app and reach the Inbox. While
# unset, replies go to EMAIL_FROM and the reply loop only works if the
# From domain itself receives mail.
EMAIL_REPLY_TO=replies@reply.yourdomain.com

# Signing secret for one-click unsubscribe links (HMAC-SHA256).
# Recommended: a random 32+ character string. While unset, the signing
# key is DERIVED from SUPABASE_SERVICE_ROLE_KEY — links keep working,
# but rotating the service-role key then invalidates older links.
# While BOTH are unset (live mode), sends omit the unsubscribe URL and
# say so in the send result rather than emitting an invalid link.
UNSUBSCRIBE_SECRET=change-me-to-a-random-64-character-string

# ── Email Warm-up Provider (Instantly) ────────────────────────────────────────
# Warm-up is operated ENTIRELY by Instantly, an external provider: you
# connect mailboxes to Instantly and enable warm-up there; Instantly's
# own network performs the gradual sending-volume ramp. NxtSend NEVER
# sends warm-up mail itself — this key is used ONLY for read-only
# status calls (Instantly API v2: list accounts + warm-up analytics),
# so the product can show the warm-up status Instantly reports.
# Create the key in Instantly → Settings → Integrations → API with the
# accounts:read scope. API access requires an active Instantly plan
# (Outreach Growth: $47/mo, $37.60/mo billed annually; warm-up included).
# ⚠️  SERVER ONLY — never prefix with NEXT_PUBLIC_.
# Leave empty/missing to keep warm-up "Unavailable — provider not
# connected" (the honest state; nothing is simulated).
INSTANTLY_API_KEY=<redacted>

# ── Mailbox OAuth (Gmail / Outlook) ───────────────────────────────────────────
# Connect REAL mailboxes so campaigns + inbox replies can send From a
# Gmail / Google Workspace or Outlook / Microsoft 365 address instead
# of EMAIL_FROM. Connection is OAuth 2.0 only — the mailbox owner
# consents on the provider's own screen; NxtSend NEVER asks for a
# mailbox password or app password. Returned tokens are stored
# ENCRYPTED (AES-256-GCM, keyed by TOKEN_ENCRYPTION_KEY below) in the
# oauth_connections table (migration 014), which is service-role-only:
# no browser code can read it, and API routes return metadata only
# (provider, address, status, token expiry) — never token material.
# Full walkthroughs: SETUP.md §15.
# ⚠️  SERVER ONLY — never prefix these with NEXT_PUBLIC_.
#
# Google Cloud Console → APIs & Services → Credentials → OAuth client
# (Web application). Register this Authorized redirect URI exactly:
#   <NEXT_PUBLIC_APP_URL>/api/oauth/google/callback
# (production example: https://nxtsend-seven.vercel.app/api/oauth/google/callback)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
#
# Azure Portal → App registrations → your app (Application (client)
# ID + a client secret VALUE under Certificates & secrets). Platform:
# Web. Register this Redirect URI exactly:
#   <NEXT_PUBLIC_APP_URL>/api/oauth/microsoft/callback
# Graph delegated permissions: User.Read, Mail.Send, Mail.Read,
# offline_access.
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
#
# AES-256 key for the token vault: base64 of exactly 32 bytes.
# Generate: openssl rand -base64 32
# While unset/malformed, mailbox connect refuses BEFORE redirecting
# to the provider (tokens could not be stored), and the Gmail/Outlook
# Integration Center entries show Configuration Required.
TOKEN_ENCRYPTION_KEY=change-me-generate-with-openssl-rand-base64-32

# ── Integration Hub (Admin) ───────────────────────────────────────────────────
# The Integration Hub (/admin/integration-hub) tracks external
# integrations (first: BizReviewRadar) and stores their credentials in
# an encrypted vault (hub_credentials, migration 016). This is a
# DEDICATED key — separate from TOKEN_ENCRYPTION_KEY above — because
# the Hub vault stores operator-entered secrets that admins can reveal
# (strict-audited), a different trust boundary from mailbox tokens.
# AES-256-GCM, base64 of exactly 32 bytes.
# Generate: openssl rand -base64 32
# ⚠️  LOSING OR ROTATING THIS KEY means every stored Hub credential
# becomes undecryptable and must be RE-ENTERED — there is no recovery.
# While unset/malformed, Hub credential create/reveal/copy refuse with
# 503 (fail closed); Hub records/checklists/documents still work.
# ⚠️  SERVER ONLY — never prefix with NEXT_PUBLIC_.
INTEGRATION_HUB_ENCRYPTION_KEY=change-me-generate-with-openssl-rand-base64-32

# ── Stripe (Billing) ──────────────────────────────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
# Leave empty/missing to use Demo Mode (no payments will be processed)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Public Stripe key (safe to expose in browser)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Stripe Price IDs — create one Product + Price per plan in the Stripe
# Dashboard (amounts per SETUP.md / src/lib/billing/plans.ts), then paste
# the price IDs (price_...) here. Checkout refuses with
# "configuration_required" for any plan whose ID is missing.
STRIPE_PRICE_ID_STARTER=price_your_starter_price_id
STRIPE_PRICE_ID_STARTER_ANNUAL=price_your_starter_annual_price_id
STRIPE_PRICE_ID_GROWTH=price_your_growth_price_id
STRIPE_PRICE_ID_GROWTH_ANNUAL=price_your_growth_annual_price_id
STRIPE_PRICE_ID_AGENCY=price_your_agency_price_id
STRIPE_PRICE_ID_AGENCY_ANNUAL=price_your_agency_annual_price_id

# ── Meta (Facebook) Pixel ─────────────────────────────────────────────────────
# Public Pixel ID (numeric) from Meta Events Manager. This is a public
# identifier, not a secret. Leave unset to disable tracking entirely —
# the loader renders nothing and makes zero network calls. Tracking also
# requires visitor consent (see SETUP.md, Meta Pixel section).
NEXT_PUBLIC_META_PIXEL_ID=

# ── AI Providers (server-side only) ───────────────────────────────────────────
# Used by the "Draft outreach message" feature (POST /api/ai/draft).
# Drafts always require human review before use; nothing is auto-sent.
# ⚠️  SERVER ONLY — never prefix these with NEXT_PUBLIC_.
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk_your_openai_api_key
# Optional model override (default gpt-4o-mini)
OPENAI_MODEL=
# Anthropic: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key
# Optional model override (default claude-sonnet-4-5)
ANTHROPIC_MODEL=

# ── Meta Model API (Muse Spark models, server-side only) ─────────────────────
# Meta's Model API: an OpenAI-compatible inference API at api.meta.ai/v1
# for Muse Spark models — used as a third AI drafting provider.
# ⚠️  SERVER ONLY — never prefix with NEXT_PUBLIC_.
# ⚠️  Endpoint details are documented via secondary sources quoting Meta's
#     developer docs (Meta's portal could not be fetched directly during
#     the 2026-10-19 research). The Integration Center's Test Connection
#     is the first primary confirmation for your key.
# Leave empty/missing to keep the Meta provider unconfigured.
MODEL_API_KEY=your_meta_model_api_key
# Optional model override (default muse-spark-1.3)
META_MODEL=

# ── Background Jobs (Vercel Cron) ─────────────────────────────────────────────
# Secret protecting POST/GET /api/jobs/run. On Vercel, when CRON_SECRET
# exists in the project env, Cron automatically sends it as
# "Authorization: Bearer <CRON_SECRET>". While unset, the worker route
# refuses to run (503) rather than accepting unauthenticated triggers.
# Generate: openssl rand -hex 32
CRON_SECRET=change-me-to-a-random-secret-before-use

# ── LinkedIn OAuth ─────────────────────────────────────────────────────────────
# Get from: https://www.linkedin.com/developers/apps
# ⚠️  LinkedIn's official API has strict rate limits and does NOT support
#     bulk automation. Use only authorized third-party integrations.
# RESERVED — NOT ACTIVE: the callback route does NOT exist yet, and
# setting these values connects NOTHING. LinkedIn stays in Demo Mode
# until an authorized provider integration is built (SETUP.md §11).
# The planned callback path is /api/integrations/linkedin/callback on
# the app origin; the value below uses the current production origin —
# replace it with the production domain at go-live. The local-dev
# equivalent is http://localhost:3000/api/integrations/linkedin/callback.
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=https://nxtsend-seven.vercel.app/api/integrations/linkedin/callback

# ── LinkedIn approved provider (RESERVED — NOT ACTIVE) ─────────────────────
# LinkedIn outreach requires an AUTHORIZED third-party provider (a
# LinkedIn partner API with its own compliance model) — LinkedIn's own
# API does not support outreach automation, and NxtSend never scrapes,
# automates browsers, or collects passwords/cookies. When you have
# procured such a provider, record it here for the adapter in
# src/lib/linkedin. RESERVED: setting these values connects NOTHING
# today — no vendor adapter is implemented yet, and credentials alone
# never mark LinkedIn "Connected".
LINKEDIN_PROVIDER=your_linkedin_provider_name
LINKEDIN_PROVIDER_API_KEY=your_linkedin_provider_api_key
