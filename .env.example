# ──────────────────────────────────────────────────────────────────────────────
# NxtSend Environment Variables
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# NEVER commit .env.local or any file containing real credentials.
# The app operates in Demo Mode when these variables are missing or placeholder.
# ──────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
# Public base URL of the application
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Set to https://nxtsend.com in production

# Node environment
NODE_ENV=development

# Force the in-app Demo Mode banner ON even when Supabase is configured
# (read by src/components/ui/DemoBanner.tsx). Banner override only —
# it does not switch the data mode. Leave unset for normal use.
NEXT_PUBLIC_DEMO_MODE=

# ── Supabase (Database & Auth) ─────────────────────────────────────────────────
# Get these from: https://app.supabase.com → Your Project → Settings → API
#
# Public (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ⚠️  SERVER ONLY — Never expose this in client-side code or the browser!
# Used for admin operations (bypasses RLS). Keep this secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Admin Bootstrap ────────────────────────────────────────────────────────────
# One-time secret used to promote the owner's account
# (mithusquare@gmail.com) to super_admin via /api/admin/bootstrap.
# After bootstrap, REMOVE this variable from your environment.
# Generate a strong value: openssl rand -base64 64
# ⚠️  Remove after first use to prevent unauthorized re-use.
ADMIN_BOOTSTRAP_SECRET=change-me-to-a-random-64-character-string-before-use

# ── Email Provider (Resend) ────────────────────────────────────────────────────
# Get from: https://resend.com/api-keys
# Leave empty/missing to use Demo Mode (no emails will be sent)
RESEND_API_KEY=re_your_resend_api_key

# From address for transactional emails (must be verified in Resend)
EMAIL_FROM=hello@nxtsend.com

# Internal inbox that receives contact-form notification email
# (POST /api/submissions, source "contact"). The notification is sent
# FROM EMAIL_FROM via Resend with the visitor's address as Reply-To.
# While this is unset, submissions are still stored and shown in
# Admin → Submissions, but the notification records "not_configured".
CONTACT_NOTIFICATION_EMAIL=nxtsendai@gmail.com

# Signing secret for Resend delivery webhooks (Svix scheme).
# Get it from the Resend dashboard when you register the webhook endpoint
# https://<your-domain>/api/webhooks/resend — starts with whsec_.
# ⚠️  While this is unset, the webhook route REJECTS events (503) rather
# than accepting them unverified.
RESEND_WEBHOOK_SECRET=whsec_your_resend_webhook_secret

# Reply-To for all outbound email (campaign steps + inbox replies).
# Point this at an address on your RECEIVING domain (see SETUP.md §6)
# so replies are delivered back to the app and reach the Inbox. While
# unset, replies go to EMAIL_FROM and the reply loop only works if the
# From domain itself receives mail.
EMAIL_REPLY_TO=replies@reply.yourdomain.com

# Signing secret for one-click unsubscribe links (HMAC-SHA256).
# Recommended: a random 32+ character string. While unset, the signing
# key is DERIVED from SUPABASE_SERVICE_ROLE_KEY — links keep working,
# but rotating the service-role key then invalidates older links.
# While BOTH are unset (live mode), sends omit the unsubscribe URL and
# say so in the send result rather than emitting an invalid link.
UNSUBSCRIBE_SECRET=change-me-to-a-random-64-character-string

# ── Mailbox OAuth (Gmail / Outlook) ───────────────────────────────────────────
# Connect REAL mailboxes so campaigns + inbox replies can send From a
# Gmail / Google Workspace or Outlook / Microsoft 365 address instead
# of EMAIL_FROM. Connection is OAuth 2.0 only — the mailbox owner
# consents on the provider's own screen; NxtSend NEVER asks for a
# mailbox password or app password. Returned tokens are stored
# ENCRYPTED (AES-256-GCM, keyed by TOKEN_ENCRYPTION_KEY below) in the
# oauth_connections table (migration 014), which is service-role-only:
# no browser code can read it, and API routes return metadata only
# (provider, address, status, token expiry) — never token material.
# Full walkthroughs: SETUP.md §15.
# ⚠️  SERVER ONLY — never prefix these with NEXT_PUBLIC_.
#
# Google Cloud Console → APIs & Services → Credentials → OAuth client
# (Web application). Register this Authorized redirect URI exactly:
#   <NEXT_PUBLIC_APP_URL>/api/oauth/google/callback
# (production example: https://nxtsend-seven.vercel.app/api/oauth/google/callback)
# ⚠️  These two are ONLY for Gmail mailbox connections. "Continue with
# Google" SIGN-IN (Supabase Auth) uses a SEPARATE OAuth client whose
# ID/secret are entered in the Supabase dashboard (Authentication →
# Providers → Google) — never in this file. See SETUP.md §3.
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
#
# Azure Portal → App registrations → your app (Application (client)
# ID + a client secret VALUE under Certificates & secrets). Platform:
# Web. Register this Redirect URI exactly:
#   <NEXT_PUBLIC_APP_URL>/api/oauth/microsoft/callback
# Graph delegated permissions: User.Read, Mail.Send, Mail.Read,
# offline_access.
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
#
# AES-256 key for the token vault: base64 of exactly 32 bytes.
# Generate: openssl rand -base64 32
# While unset/malformed, mailbox connect refuses BEFORE redirecting
# to the provider (tokens could not be stored), and the Gmail/Outlook
# Integration Center entries show Configuration Required.
TOKEN_ENCRYPTION_KEY=change-me-generate-with-openssl-rand-base64-32

# ── Integration Hub (Admin) ───────────────────────────────────────────────────
# The Integration Hub (/admin/integration-hub) tracks external
# integrations (first: BizReviewRadar) and stores their credentials in
# an encrypted vault (hub_credentials, migration 016). This is a
# DEDICATED key — separate from TOKEN_ENCRYPTION_KEY above — because
# the Hub vault stores operator-entered secrets that admins can reveal
# (strict-audited), a different trust boundary from mailbox tokens.
# AES-256-GCM, base64 of exactly 32 bytes.
# Generate: openssl rand -base64 32
# ⚠️  LOSING OR ROTATING THIS KEY means every stored Hub credential
# becomes undecryptable and must be RE-ENTERED — there is no recovery.
# While unset/malformed, Hub credential create/reveal/copy refuse with
# 503 (fail closed); Hub records/checklists/documents still work.
# ⚠️  SERVER ONLY — never prefix with NEXT_PUBLIC_.
INTEGRATION_HUB_ENCRYPTION_KEY=change-me-generate-with-openssl-rand-base64-32

# ── Stripe (Billing) ──────────────────────────────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
# Leave empty/missing to use Demo Mode (no payments will be processed)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Public Stripe key (safe to expose in browser)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Stripe Price IDs — create one Product + Price per plan in the Stripe
# Dashboard (amounts per SETUP.md / src/lib/billing/plans.ts), then paste
# the price IDs (price_...) here. Checkout refuses with
# "configuration_required" for any plan whose ID is missing.
STRIPE_PRICE_ID_STARTER=price_your_starter_price_id
STRIPE_PRICE_ID_STARTER_ANNUAL=price_your_starter_annual_price_id
STRIPE_PRICE_ID_GROWTH=price_your_growth_price_id
STRIPE_PRICE_ID_GROWTH_ANNUAL=price_your_growth_annual_price_id
STRIPE_PRICE_ID_AGENCY=price_your_agency_price_id
STRIPE_PRICE_ID_AGENCY_ANNUAL=price_your_agency_annual_price_id

# ── Meta (Facebook) Pixel ─────────────────────────────────────────────────────
# Public Pixel ID (numeric) from Meta Events Manager. This is a public
# identifier, not a secret. Leave unset to disable tracking entirely —
# the loader renders nothing and makes zero network calls. Tracking also
# requires visitor consent (see SETUP.md, Meta Pixel section).
NEXT_PUBLIC_META_PIXEL_ID=

# ── AI Providers (server-side only) ───────────────────────────────────────────
# Used by the "Draft outreach message" feature (POST /api/ai/draft).
# Drafts always require human review before use; nothing is auto-sent.
# ⚠️  SERVER ONLY — never prefix these with NEXT_PUBLIC_.
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk_your_openai_api_key
# Optional model override (default gpt-4o-mini)
OPENAI_MODEL=
# Anthropic: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key
# Optional model override (default claude-sonnet-4-5)
ANTHROPIC_MODEL=

# ── Meta Model API (Muse Spark models, server-side only) ─────────────────────
# Meta's Model API: an OpenAI-compatible inference API at api.meta.ai/v1
# for Muse Spark models — used as a third AI drafting provider.
# ⚠️  SERVER ONLY — never prefix with NEXT_PUBLIC_.
# ⚠️  Endpoint details are documented via secondary sources quoting Meta's
#     developer docs (Meta's portal could not be fetched directly during
#     the 2026-10-19 research). The Integration Center's Test Connection
#     is the first primary confirmation for your key.
# Leave empty/missing to keep the Meta provider unconfigured.
MODEL_API_KEY=your_meta_model_api_key
# Optional model override (default muse-spark-1.3)
META_MODEL=

# ── Background Jobs (Vercel Cron) ─────────────────────────────────────────────
# Secret protecting POST/GET /api/jobs/run. On Vercel, when CRON_SECRET
# exists in the project env, Cron automatically sends it as
# "Authorization: Bearer <CRON_SECRET>". While unset, the worker route
# refuses to run (503) rather than accepting unauthenticated triggers.
# Generate: openssl rand -hex 32
CRON_SECRET=change-me-to-a-random-secret-before-use

# ── LinkedIn OAuth ─────────────────────────────────────────────────────────────
# Get from: https://www.linkedin.com/developers/apps
# ⚠️  LinkedIn's official API has strict rate limits and does NOT support
#     bulk automation. Use only authorized third-party integrations.
# RESERVED — NOT ACTIVE: the callback route does NOT exist yet, and
# setting these values connects NOTHING. LinkedIn stays in Demo Mode
# until an authorized provider integration is built (SETUP.md §11).
# The planned callback path is /api/integrations/linkedin/callback on
# the app origin; the value below uses the current production origin —
# replace it with the production domain at go-live. The local-dev
# equivalent is http://localhost:3000/api/integrations/linkedin/callback.
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=https://nxtsend-seven.vercel.app/api/integrations/linkedin/callback

# ── LinkedIn approved provider (RESERVED — NOT ACTIVE) ─────────────────────
# LinkedIn outreach requires an AUTHORIZED third-party provider (a
# LinkedIn partner API with its own compliance model) — LinkedIn's own
# API does not support outreach automation, and NxtSend never scrapes,
# automates browsers, or collects passwords/cookies. When you have
# procured such a provider, record it here for the adapter in
# src/lib/linkedin. RESERVED: setting these values connects NOTHING
# today — no vendor adapter is implemented yet, and credentials alone
# never mark LinkedIn "Connected".
LINKEDIN_PROVIDER=your_linkedin_provider_name
LINKEDIN_PROVIDER_API_KEY=your_linkedin_provider_api_key

# ── Muse (Meta) Connector — OAuth 2.1 server + MCP surface ────────────────
# NxtSend is the SERVER in the Muse Connector Platform: Muse calls
# INTO NxtSend (hosted MCP at /api/mcp) on behalf of a signed-in
# NxtSend user, authenticated with OAuth 2.0 authorization-code +
# PKCE (S256) that NxtSend issues (src/lib/muse-connector/oauth/,
# migration 023). Nothing here has been submitted to Meta — the
# connector manifest stays a pre-classified draft until the owner
# submits at muse.ai/platform and Meta approves.
#
# MUSE_MCP_ENABLED — set to "false" to disable the Muse MCP surface.
# Unset (or "true") means enabled. The OAuth routes stay available
# when disabled, so a grant can never be half-issued against a dead
# MCP server; the MCP server itself reads this flag.
MUSE_MCP_ENABLED=
# Public origin advertised in the RFC 9728 protected-resource
# metadata (/.well-known/oauth-protected-resource/api/mcp). Only set
# this when the Muse surface lives somewhere other than
# NEXT_PUBLIC_APP_URL — otherwise leave it unset and the app URL is
# used. No MUSE_OAUTH_CLIENT_SECRET is needed: Muse clients register
# themselves via Dynamic Client Registration (POST
# /api/muse/oauth/register) and are public by default; NxtSend issues
# the credentials. TOKEN_ENCRYPTION_KEY (above) is reused to sign the
# authorize-request state — no extra key is needed.
MUSE_MCP_PUBLIC_URL=

# ── ChatGPT (OpenAI) Connector — OAuth 2.1 server + MCP surface ─────────
# Same shape as the Muse surface above, for ChatGPT (chatgpt.com):
# NxtSend is the SERVER — ChatGPT calls INTO NxtSend (hosted MCP at
# /api/mcp/chatgpt, 54 tools) on behalf of a signed-in NxtSend user,
# authenticated with OAuth 2.0 authorization-code + PKCE (S256) that
# NxtSend issues (src/lib/muse-connector/oauth/, migrations 023 +
# 024). Nothing here has been submitted to OpenAI — the connector
# stays testable in ChatGPT Developer Mode until the owner submits
# it to OpenAI and OpenAI approves.
#
# CHATGPT_MCP_ENABLED — set to "false" to disable the ChatGPT MCP
# surface. Unset means the MUSE_MCP_ENABLED value applies; both
# unset means enabled. The OAuth routes stay available when
# disabled, so a grant can never be half-issued against a dead MCP
# server; the MCP server itself reads this flag.
CHATGPT_MCP_ENABLED=
# Public origin advertised in the RFC 9728 protected-resource
# metadata (/.well-known/oauth-protected-resource). Only set this
# when the ChatGPT surface lives somewhere other than
# MUSE_MCP_PUBLIC_URL or NEXT_PUBLIC_APP_URL — otherwise leave it
# unset. Precedence: CHATGPT_MCP_PUBLIC_URL, then
# MUSE_MCP_PUBLIC_URL, then NEXT_PUBLIC_APP_URL.
# NO CHATGPT_OAUTH_CLIENT_SECRET exists or is needed: ChatGPT
# clients identify themselves with a CIMD client_id URL or register
# via Dynamic Client Registration (POST /api/muse/oauth/register)
# and are public by default; NxtSend issues the credentials.
# TOKEN_ENCRYPTION_KEY (above) is reused to sign the
# authorize-request state — no extra key is needed.
# OPENAI_API_KEY is NOT required for this integration: the MCP
# connection itself needs no OpenAI key. The existing AI providers
# (OpenAI/Anthropic/Meta) are reused only for message drafting via
# the existing draftOutreachMessage tool.
CHATGPT_MCP_PUBLIC_URL=

# ── Claude (Anthropic) Connector — OAuth 2.1 server + MCP surface ────────
# Same shape as the ChatGPT surface above, for Claude (claude.ai /
# claude.com): NxtSend is the SERVER — Claude calls INTO NxtSend
# (hosted MCP at /api/mcp/claude, 54 tools) on behalf of a signed-in
# NxtSend user, authenticated with OAuth 2.0 authorization-code +
# PKCE (S256) that NxtSend issues (src/lib/muse-connector/oauth/,
# migrations 023 + 024). Nothing here has been submitted to
# Anthropic — the connector stays testable as a custom connector in
# Claude (Customize → Connectors → Add custom connector) until the
# owner submits it to Anthropic and Anthropic approves.
#
# CLAUDE_MCP_ENABLED — set to "false" to disable the Claude MCP
# surface. Unset means the MUSE_MCP_ENABLED value applies; both
# unset means enabled. The OAuth routes stay available when
# disabled, so a grant can never be half-issued against a dead MCP
# server; the MCP server itself reads this flag.
CLAUDE_MCP_ENABLED=
# Public origin advertised in the RFC 9728 protected-resource
# metadata (/.well-known/oauth-protected-resource/api/mcp/claude).
# Only set this when the Claude surface lives somewhere other than
# MUSE_MCP_PUBLIC_URL or NEXT_PUBLIC_APP_URL — otherwise leave it
# unset. Precedence: CLAUDE_MCP_PUBLIC_URL, then
# MUSE_MCP_PUBLIC_URL, then NEXT_PUBLIC_APP_URL.
# NO CLAUDE_OAUTH_CLIENT_SECRET exists or is needed: Claude
# clients register via Dynamic Client Registration (POST
# /api/muse/oauth/register) or identify themselves with a CIMD
# client_id URL and are public by default; NxtSend issues the
# credentials. Claude's Advanced-settings client ID/secret fields
# are an optional fallback for pre-registered clients only, not
# required for this connection. TOKEN_ENCRYPTION_KEY (above) is
# reused to sign the authorize-request state — no extra key is
# needed.
# ANTHROPIC_API_KEY is NOT required for this integration: the MCP
# connection itself needs no Anthropic key. The existing AI
# providers (OpenAI/Anthropic/Meta) are reused only for message
# drafting via the existing draftOutreachMessage tool.
CLAUDE_MCP_PUBLIC_URL=

# ── Zapier Connector — OAuth 2.0 server + REST API ─────────────────────────
# Same authorization server as Muse/ChatGPT/Claude, for Zapier
# (zapier.com): Zapier calls INTO NxtSend (REST API at
# /api/integrations/zapier/v1, webhooks via REST Hooks) on behalf of
# a signed-in NxtSend user, authenticated with OAuth 2.0
# authorization-code that NxtSend issues
# (src/lib/muse-connector/oauth/ + src/lib/integrations/zapier/,
# migrations 025/026/027). Nothing here has been submitted to
# Zapier — the integration stays testable in Zapier's developer
# platform until the owner publishes it.
#
# ZAPIER_ENABLED — set to "false" to disable the Zapier REST API
# surface. Unset (or "true") means enabled. The OAuth routes stay
# available when disabled, so a grant can never be half-issued
# against a dead API; the Zapier routes themselves read this flag.
# ZAPIER_APP_BASE_URL — public origin advertised in the RFC 9728
# protected-resource metadata
# (/.well-known/oauth-protected-resource/api/integrations/zapier).
# Only set this when the Zapier surface lives somewhere other than
# NEXT_PUBLIC_APP_URL — otherwise leave it unset and the app URL is
# used.
# NO ZAPIER_OAUTH_CLIENT_SECRET exists or is needed: the Zapier
# client is created by a one-time Dynamic Client Registration call
# (POST /api/muse/oauth/register with the Zapier redirect URI from
# the Zapier developer dashboard — see
# docs/zapier-integration/ZAPIER_SERVER.md) and its credentials are
# entered in Zapier, not here. No global webhook signing secret
# either: each Zapier webhook subscription gets its own secret,
# generated server-side at subscribe time.
# Delivery honesty: the immediate webhook attempt at event time is
# best-effort; retries run on the daily 06:00 cron, so a failed
# delivery may wait up to ~24h for its next attempt.
ZAPIER_ENABLED=
ZAPIER_APP_BASE_URL=

# ── n8n Connector — OAuth 2.0 server + API keys + REST API ────────────────
# Same authorization server as Muse/ChatGPT/Claude/Zapier, for n8n
# (n8n.io): n8n calls INTO NxtSend (REST API at
# /api/integrations/n8n/v1, webhooks via the NxtSend Trigger node) on
# behalf of a signed-in NxtSend user, authenticated either with
# OAuth 2.0 authorization-code that NxtSend issues
# (src/lib/muse-connector/oauth/ + src/lib/integrations/n8n/,
# migrations 028/029) or with a scoped API key created in-app
# (Settings → Integrations → n8n). The community node package
# n8n-nodes-nxtsend (integrations/n8n-nodes-nxtsend/) is NOT
# published on npm and NOT verified by n8n — it does not appear in
# n8n's community-node directory until the owner publishes it.
#
# N8N_INTEGRATION_ENABLED — set to "false" to disable the n8n REST
# API surface. Unset (or "true") means enabled. The OAuth routes stay
# available when disabled, so a grant can never be half-issued
# against a dead API; the n8n routes themselves read this flag.
# N8N_API_BASE_URL — public origin advertised in the RFC 9728
# protected-resource metadata
# (/.well-known/oauth-protected-resource/api/integrations/n8n).
# Only set this when the n8n surface lives somewhere other than
# NEXT_PUBLIC_APP_URL — otherwise leave it unset and the app URL is
# used.
# NO N8N_API_KEY exists or is needed: NxtSend API keys are generated
# in-app (Settings → Integrations → n8n) and stored as hashes —
# NxtSend API keys ≠ n8n instance credentials (the login to your own
# n8n instance is unrelated and is never entered here).
# NO N8N_OAUTH_CLIENT_SECRET exists or is needed: the n8n client is
# created by a one-time Dynamic Client Registration call
# (POST /api/muse/oauth/register with the n8n redirect URI — see
# docs/n8n-integration/API_AUTHENTICATION.md) and its credentials are
# entered in n8n, not here. No global webhook signing secret
# either: each n8n webhook subscription gets its own secret,
# generated server-side at subscribe time.
# Delivery honesty: the immediate webhook attempt at event time is
# best-effort; retries run on the daily 06:00 cron, so a failed
# delivery may wait up to ~24h for its next attempt.
N8N_INTEGRATION_ENABLED=
N8N_API_BASE_URL=

# ── Make / Pabbly / Albato / Activepieces Connectors — OAuth 2.0 server + REST API ──
# Same authorization server as Zapier/n8n, for Make (make.com),
# Pabbly Connect (pabbly.com), Albato (albato.com) and Activepieces
# (activepieces.com): each platform calls INTO NxtSend (REST API at
# /api/integrations/<platform>/v1, webhooks via REST Hooks) on behalf
# of a signed-in NxtSend user, authenticated with OAuth 2.0
# authorization-code that NxtSend issues
# (src/lib/muse-connector/oauth/ + src/lib/integrations/rest/,
# migrations 025–027 + 029). Scopes are <platform>.read +
# <platform>.write only — there is no <platform>.send tier, and
# LinkedIn-send actions are not supported on any platform. Nothing
# here has been submitted to Make, Pabbly, Albato or Activepieces —
# each integration stays testable in that platform's developer
# tooling until the owner publishes/submits it.
#
# <PLATFORM>_ENABLED — set to "false" to disable that platform's
# REST API surface. Unset (or "true") means enabled. The OAuth routes
# stay available when disabled, so a grant can never be half-issued
# against a dead API; the platform routes themselves read this flag.
# <PLATFORM>_API_BASE_URL — public origin advertised in the RFC 9728
# protected-resource metadata
# (/.well-known/oauth-protected-resource/api/integrations/<platform>).
# Only set this when the platform surface lives somewhere other than
# NEXT_PUBLIC_APP_URL — otherwise leave it unset and the app URL is
# used.
# NO <PLATFORM>_OAUTH_CLIENT_SECRET exists or is needed: each
# platform client is created by a one-time Dynamic Client
# Registration call (POST /api/muse/oauth/register with the
# platform's redirect URI) and its credentials are entered in the
# platform, not here. No global webhook signing secret either: each
# webhook subscription gets its own secret, generated server-side
# at subscribe time. API keys are n8n-only (nxt_live_ keys
# authorize /api/integrations/n8n/v1 only) — Make, Pabbly, Albato
# and Activepieces authenticate with OAuth grants, never API keys.
# Delivery honesty: the immediate webhook attempt at event time is
# best-effort; retries run on the daily 06:00 cron, so a failed
# delivery may wait up to ~24h for its next attempt.
MAKE_ENABLED=
MAKE_API_BASE_URL=
PABBLY_ENABLED=
PABBLY_API_BASE_URL=
ALBATO_ENABLED=
ALBATO_API_BASE_URL=
ACTIVEPIECES_ENABLED=
ACTIVEPIECES_API_BASE_URL=

# ── Email Outreach providers (server-side env fallbacks) ─────────────────────
# Each provider below authenticates with a credential stored
# ENCRYPTED per workspace in integration_connections (migration
# 030) — that stored connection is tried FIRST. The variable named
# here is the server-side env fallback declared in the provider's
# adapter config (src/lib/integrations/providers/email-outreach/*/config.ts,
# `envVar` / `*_ENV_VARS`): set it only when no stored connection
# exists for the workspace. The adapter itself takes its credential
# from the encrypted store; the name below is the conventional
# operator-facing name for the credential that seeds a connection.
# ⚠️  SERVER ONLY — never prefix these with NEXT_PUBLIC_.
# All of these are OPTIONAL — leave unset to keep the provider
# unconfigured (status stays Not Connected until a credential is
# stored or a fallback is set). None of these providers is
# live-verified against a real account yet; see the Integration
# Center entry for each provider's verified endpoints.
#
# EmailBison API token (Settings > Developer API > New API Token).
# Scoped to the workspace where it was created. Sent as a Bearer token.
EMAILBISON_API_KEY=your_emailbison_api_key
# Instantly API v2 key (Settings > Integrations > API Keys, Version 2;
# Growth plan or above). Sent as a Bearer token.
INSTANTLY_API_KEY=your_instantly_api_key
# Lemlist API key (Settings > Integrations > API Key). HTTP Basic auth
# with an empty username and the key as the password.
LEMLIST_API_KEY=your_lemlist_api_key
# Mailshake API key (Extensions > API > Create API Key). HTTP Basic
# auth with the key as the username.
MAILSHAKE_API_KEY=your_mailshake_api_key
# Master Inbox API key (Settings > APIs > Create new key).
# Per-account, named, revocable. Header scheme not verified — no live
# call is made until a read endpoint is verified.
MASTERINBOX_API_KEY=your_masterinbox_api_key
# Reply.io API key (Settings > API Key). Scoped per key; sent in the
# X-Api-Key header (Authorization: Bearer also accepted).
REPLY_API_KEY=your_reply_api_key
# Smartlead API key (Settings > API Keys). Sent as the api_key query
# parameter on every request — Smartlead's only auth method; it is
# never sent as a header.
SMARTLEAD_API_KEY=your_smartlead_api_key
# SmartReach REST API key (Settings > Integrations > SmartReach API >
# Get API Key > Generate New API Key). Sent in the X-API-KEY header.
SMARTREACH_API_KEY=your_smartreach_api_key
# Snov.io API User ID + API Secret (Account > API). Exchanged for a
# 1-hour Bearer token (POST /v1/oauth/access_token, client_credentials
# grant). The secret is stored as extra.client_secret on the
# credential, never as its own env var in code.
SNOV_API_USER_ID=your_snov_api_user_id
SNOV_API_SECRET=your_snov_api_secret
# Woodpecker API key (Marketplace > Integrations > API keys > Create a
# key). User-specific. Sent in the x-api-key header.
WOODPECKER_API_KEY=your_woodpecker_api_key
# HotHawk API key (https://hothawk.ai/developers). Sent as
# Authorization: Bearer. HotHawk's /linkedin/* endpoints are
# deliberately not wired — no LinkedIn send.
HOTHAWK_API_KEY=your_hothawk_api_key

# ── Lead Enrichment providers (server-side env fallbacks) ────────────────────
# Same fallback rule as Email Outreach above: the stored encrypted
# per-workspace connection is tried FIRST; the variable named here
# is the server-side env fallback declared in the provider's adapter
# config (src/lib/integrations/providers/enrichment/*/config.ts and
# src/lib/integrations/providers/category-j/*/config.ts, `envVars`),
# read by the shared resolver in
# src/lib/integrations/providers/enrichment/common.ts
# (resolveProviderApiKey). ⚠️  SERVER ONLY.
# All OPTIONAL. None of these providers is live-verified against a
# real account yet; see the Integration Center entry for each
# provider's verified endpoints. Deliberately ABSENT here: Clearbit
# (standalone API deprecated after the HubSpot acquisition), Trigify
# (shut down 22 October 2026) and Weezly (no public developer API) —
# do not set credentials for those providers; their adapters refuse
# every operation.
#
# Apify API token (https://docs.apify.com/api/v2).
APIFY_TOKEN=your_apify_token
# Apollo.io API key (https://docs.apollo.io/). Sent as the x-api-key header.
APOLLO_API_KEY=your_apollo_api_key
# Clay API key (https://developers.clay.com).
CLAY_API_KEY=your_clay_api_key
# ContactOut API key (https://contactout.com/api_docs/).
CONTACTOUT_API_KEY=your_contactout_api_key
# Dropcontact API key (https://developer.dropcontact.com/).
DROPCONTACT_API_KEY=your_dropcontact_api_key
# Factors.ai API key (https://help.factors.ai/en/). Config-ready only —
# the Factors API reference was not verified; endpoints unverified.
FACTORS_API_KEY=your_factors_api_key
# Hunter.io API key (https://hunter.io/api-documentation). Shared with
# the Hunter Email Verifier entry below — one key, both providers.
HUNTER_API_KEY=your_hunter_api_key
# Persana AI API key (https://persana.ai/full-contact-api).
# Config-ready only — no public API reference found; endpoints unverified.
PERSANA_API_KEY=your_persana_api_key
# RB2B webhook secret (https://support.rb2b.com/). RB2B is
# webhook-only (no pull API) and covers US traffic only.
RB2B_WEBHOOK_SECRET=your_rb2b_webhook_secret
# SalesQL API key (https://salesql.com/api). Sent as a Bearer token.
SALESQL_API_KEY=your_salesql_api_key
# Snov.io OAuth client credentials for enrichment
# (https://snov.io/api). Distinct from the email-outreach
# SNOV_API_USER_ID / SNOV_API_SECRET pair above.
SNOV_CLIENT_ID=your_snov_client_id
SNOV_CLIENT_SECRET=your_snov_client_secret
# ZoomInfo OAuth client credentials (https://docs.gtm.ai/docs/overview).
# Access token for the legacy Enterprise API paths; GTM API paths unverified.
ZOOMINFO_CLIENT_ID=your_zoominfo_client_id
ZOOMINFO_CLIENT_SECRET=your_zoominfo_client_secret
ZOOMINFO_ACCESS_TOKEN=your_zoominfo_access_token
# GetLeads API key (https://www.getleads.io/docs/). Sent as
# Authorization: Bearer <keyId>_<secret> (or X-API-Key).
GETLEADS_API_KEY=your_getleads_api_key
# Cornersight API key (cs_ prefix, https://app.cornersight.io/docs).
# Sent as the X-API-Key header. Cornersight leads carry no email —
# it does not sell emails.
CORNERSIGHT_API_KEY=your_cornersight_api_key

# ── Email Verification providers (server-side env fallbacks) ─────────────────
# Same fallback rule as Lead Enrichment above: stored encrypted
# per-workspace connection first, env fallback second, read by the
# shared resolver (src/lib/integrations/providers/enrichment/common.ts).
# Configs live in src/lib/integrations/providers/verification/*/config.ts.
# ⚠️  SERVER ONLY. All OPTIONAL. HUNTER_API_KEY is defined in the
# Lead Enrichment section above (shared with Hunter.io enrichment)
# and is not repeated here.
#
# Bouncer API key (https://www.usebouncer.com/api-documentation/).
BOUNCER_API_KEY=your_bouncer_api_key
# MillionVerifier API key (https://developer.millionverifier.com).
MILLIONVERIFIER_API_KEY=your_millionverifier_api_key
# NeverBounce API key (https://developers.neverbounce.com/v4.0/).
NEVERBOUNCE_API_KEY=your_neverbounce_api_key
# ZeroBounce API key (https://www.zerobounce.net/docs/email-validation-api-quickstart/v2-validate-emails).
ZEROBOUNCE_API_KEY=your_zerobounce_api_key

# ── Communication providers (server-side env fallbacks) ──────────────────────
# Same fallback rule: stored encrypted per-workspace connection
# first, env fallback second. Configs live in
# src/lib/integrations/providers/communication/*/config.ts
# (`envVars`). ⚠️  SERVER ONLY. All OPTIONAL. Webhook URLs are
# secrets (the URL itself is the credential) — leave empty unless
# you intend the fallback, and never paste a real webhook URL into
# a shared file. Only the credential names are listed here; target
# settings (channel id, phone-number id, template name, …) are
# stored-connection settings, not environment variables.
#
# Discord channel webhook URL (https://discord.com/api/webhooks/<id>/<token>).
DISCORD_WEBHOOK_URL=
# Slack incoming-webhook URL for the target channel, or bot token
# (xoxb-…) with chat:write for chat.postMessage delivery when no
# webhook is stored.
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=your_slack_bot_token
# Microsoft Teams Workflows webhook URL for the target channel.
# (The Office 365 Connector / incoming-webhook path is deprecated —
# new webhooks must be created as Workflows.)
TEAMS_WEBHOOK_URL=
# Telegram bot token from @BotFather (https://core.telegram.org/bots/api).
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# WhatsApp Business Cloud API permanent system-user access token
# with whatsapp_business_messaging
# (https://developers.facebook.com/docs/whatsapp/cloud-api).
# The temporary dashboard token lasts ~24h and is testing-only.
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token

# ── Productivity providers (server-side env fallbacks) ───────────────────────
# Same fallback rule: stored encrypted per-workspace connection
# first, env fallback second. Configs live in
# src/lib/integrations/providers/productivity/*/config.ts
# (`envVars`). ⚠️  SERVER ONLY. All OPTIONAL. Only the credential
# names are listed here; target settings (base id, table id, board
# id, list id, project key, team id, database id, …) are
# stored-connection settings, not environment variables.
# Google Sheets / Calendar / Drive reuse the GOOGLE_CLIENT_ID +
# GOOGLE_CLIENT_SECRET pair from the Mailbox OAuth section above
# (already defined) — no new variables for them here.
#
# Airtable personal access token with data.records:read +
# data.records:write on the target base (legacy API keys were shut
# off 1 Feb 2024). https://airtable.com/developers/web/api/introduction
AIRTABLE_PAT=your_airtable_pat
# Asana personal access token (Developer Console → Personal access
# tokens) or OAuth access token, with tasks:write.
# https://developers.asana.com/reference/rest-api-reference
ASANA_ACCESS_TOKEN=your_asana_access_token
# Calendly OAuth access token or personal access token.
# https://developer.calendly.com/api-docs
CALENDLY_ACCESS_TOKEN=your_calendly_access_token
# ClickUp personal API token (pk_…) from Settings → Apps → API Token.
# https://developer.clickup.com/reference
CLICKUP_API_TOKEN=your_clickup_api_token
# Jira Cloud API token from Atlassian account security settings
# (Basic auth with the account email; passwords have not worked for
# Cloud since 2019). Jira Cloud only — Data Center is not covered.
# https://developer.atlassian.com/cloud/jira/platform/rest/v3/
JIRA_API_TOKEN=your_jira_api_token
# Linear personal API key from Settings → API (or an OAuth access
# token). https://linear.app/developers
LINEAR_API_KEY=your_linear_api_key
# Monday.com API token (avatar → Administration → API, or Developers
# → My Access Tokens). Sent as the raw Authorization header value.
# https://developer.monday.com/api-reference/
MONDAY_API_TOKEN=your_monday_api_token
# Notion internal integration secret (ntn_… / secret_…). Create the
# integration in Notion → Settings → Connections, then share the
# target database with it. https://developers.notion.com/reference/intro
NOTION_TOKEN=your_notion_token
# Trello API key + API token from trello.com/app-key (the key
# identifies the app; the token grants access to the account).
# https://developer.atlassian.com/cloud/trello/rest/
TRELLO_API_KEY=your_trello_api_key
TRELLO_TOKEN=your_trello_token
