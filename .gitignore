# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*.local

# Zapier Platform CLI app (integrations/zapier/) — generated / local-only.
# The app itself IS committed; its dependencies, build output and the
# register credential file are not. .zapierapprc is written by
# `zapier-platform register` and holds the app's deploy identity —
# never commit it.
integrations/zapier/node_modules/
integrations/zapier/build/
integrations/zapier/.zapierapprc

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
